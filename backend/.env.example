# ─────────────────────────────────────────────────────────────
# NOMADDI PANEL CENTRAL — Variables de entorno
# Copiar a .env y completar con valores reales
# ─────────────────────────────────────────────────────────────

APP_NAME="Nomaddi Panel Central"
APP_ENV=production
APP_KEY=          # php artisan key:generate
APP_DEBUG=false
APP_URL=https://panel.campusvirtual.edu.co

# ── Base de datos ─────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nomaddi_panel
DB_USERNAME=nomaddi_user
DB_PASSWORD=

# ── Moodle API REST ───────────────────────────────────────────
# URL base del campus (sin slash final)
MOODLE_URL=https://campusvirtual.edu.co
# Token del webservice (Administración → Plugins → Servicios externos → Token)
MOODLE_TOKEN=

# ── ePayco ────────────────────────────────────────────────────
# p_cust_id_cliente de tu cuenta ePayco
EPAYCO_CUST_ID=
# Llave privada de tu cuenta ePayco
EPAYCO_SECRET_KEY=

# ── Cola de trabajos (para envíos de correo asíncronos) ───────
QUEUE_CONNECTION=database

# ── Correo saliente ───────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@campusvirtual.edu.co
MAIL_FROM_NAME="Campus Virtual Nomaddi"

# ── Logs ──────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=info
